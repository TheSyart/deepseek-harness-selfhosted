NODE_ENV=production
DSH_HOME=/app/data/config
DSH_AGENTS_HOME=/app/data/agents
DSH_TELEMETRY_DISABLED=1
# Comma-separated authorities, without URL schemes or wildcard entries.
DSH_TRUSTED_HOSTS=dsh.example.invalid
DEEPSEEK_API_KEY=
# Set only when an existing provider uses a custom endpoint.
DEEPSEEK_BASE_URL=
