{
  "version": 2,
  "build": {
    "kind": "image",
    "workflow": "serverops-image.yml"
  },
  "runtime": {
    "kind": "compose",
    "services": [
      {
        "name": "web",
        "image": "ghcr.io/thesyart/deepseek-harness-selfhosted",
        "port": 3080,
        "healthPath": "/",
        "data": [
          {
            "name": "config",
            "target": "/app/data/config"
          },
          {
            "name": "agents",
            "target": "/app/data/agents"
          },
          {
            "name": "workspace",
            "target": "/app/data/workspace"
          }
        ]
      }
    ]
  }
}
